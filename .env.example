# Copy to .env and fill in. Never commit real values.
APP_ENV=development

# Separate roles: the app is limited by Row Level Security; the worker serves all tenants.
DATABASE_URL_APP=postgres://newsflow_app:CHANGE_ME@localhost:5432/newsflow
DATABASE_URL_WORKER=postgres://newsflow_worker:CHANGE_ME@localhost:5432/newsflow

# 32 random bytes, base64. In production this comes from a secrets manager / KMS.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
MASTER_KEY_ID=mk-1

# At least 32 characters.
TOKEN_SECRET=

# fake = simulated WhatsApp. baileys = real linked devices (needs ALLOW_REAL_WHATSAPP=1 and owner approval).
WA_MODE=fake
ALLOW_REAL_WHATSAPP=0
ALLOW_REAL_TELEGRAM=0

MEDIA_DIR=./.media
API_PORT=8787
DEV_TOKENS=1
LOG_LEVEL=info

# Super Admin API (optional; separate database role and secret)
DATABASE_URL_ADMIN=postgres://newsflow_admin:CHANGE_ME@localhost:5432/newsflow
ADMIN_TOKEN_SECRET=
