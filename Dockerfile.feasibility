# Feasibility test image: the core plus the real Baileys client.
# Approved by the owner on 2026-10-20 for one test number.
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
# Official package name only ("baileys", WhiskeySockets). A malicious look-alike fork once stole sessions.
RUN npm install --no-audit --no-fund --no-save baileys@~6.7.0 tsx@4 && npm ls baileys
CMD ["npx", "tsx", "scripts/feasibility.ts"]
